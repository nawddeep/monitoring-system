# cp .env.example .env   (.env is gitignored; never commit it)

# Local Docker PostgreSQL (default). Change the password for anything beyond your own laptop.
POSTGRES_USER=lake
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lake_monitoring
POSTGRES_PORT=5432

# Connection string the data API uses. Local by default.
# For the live Neon database, set this in Vercel (Settings > Environment Variables),
# using Neon's pooled URL and a read-only role. Do not put it in git.
DATABASE_URL=postgresql://lake:change_me@localhost:5432/lake_monitoring
