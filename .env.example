# cp .env.example .env   (.env is gitignored; never commit it)

# Local Docker PostgreSQL (default). Change the password for anything beyond your own laptop.
POSTGRES_USER=lake
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lake_monitoring
POSTGRES_PORT=5432

# Connection string the data API uses. Local by default.
# For the live Neon database, set DASHBOARD_DATABASE_URL in Vercel (Settings > Environment Variables)
# to Neon's pooled URL for the read-only role. Do not put it in git, and do not reuse DATABASE_URL
# (the Neon integration sets that to the owner login).
DASHBOARD_DATABASE_URL=postgresql://lake:change_me@localhost:5432/lake_monitoring

# Sensor ingest (POST /api/telemetry). INGEST_DATABASE_URL must be the INSERT-only role from
# db/neon-ingest-role.sql; INGEST_TOKEN must equal the token inside the board's firmware.
INGEST_DATABASE_URL=
INGEST_TOKEN=
STATION_NAME=FS_LAKE_STATION_01
